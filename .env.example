# Create .env only if absent; preserve existing local configuration.
# Existing startup process variables take precedence.
# Deterministic local provider: no real model credentials.
FINAGENT_AGENT_PROVIDER=local
# Explicitly labeled offline sample data, never live market data.
FINAGENT_DEMO_DATA=1
# Startup-only options: set in the process environment BEFORE launching.
# FINAGENT_USER_DATA_DIR selects the profile before .env is loaded.
# FINAGENT_ENV_FILE selects which file to load; cannot select itself from .env.
# PowerShell example: $env:FINAGENT_USER_DATA_DIR = 'E:/isolated-profile'
